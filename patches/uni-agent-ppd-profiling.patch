                 logger.info(f"Exit: token budget spent ({info['total_tokens']}/{cfg.model.max_total_tokens}).")
                 return "token_limit"
             max_tokens = min(max_tokens, remaining)
+        # PPD fix: clamp the per-turn cap to the server's context window minus the
+        # estimated prompt (transcript + accumulated tool observations). Without this,
+        # a long multi-turn conversation eventually asks for more than
+        # max_model_len - input_tokens and vLLM rejects the request.
+        if cfg.model.max_context_len is not None:
+            est_prompt = info.get("est_prompt_tokens", 0)
+            # 1024-token safety margin absorbs observation-tokenization error
+            headroom = cfg.model.max_context_len - est_prompt - 1024
+            if max_tokens is not None:
+                max_tokens = min(max_tokens, headroom)
+            else:
+                max_tokens = headroom
+            if max_tokens <= 0:
+                logger.warning(
+                    f"Context window exhausted (est_prompt={est_prompt}); "
+                    "sending a 64-token call so the policy can still emit a finish tool."
+                )
+                max_tokens = 64
 
         sampling_params: dict[str, Any] = cfg.model.sampling_params()
         if max_tokens is not None:  # both budgets unset -> let the server run to EOS
@@ -162,6 +192,7 @@ class ReActAgent(Agent):
